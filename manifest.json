{
  "manifest_version": 3,
  "name": "Chiphell 快速评分",
  "version": "1.4.1",
  "description": "自动填写 Chiphell 评分，并支持本页或整帖按作者批量加分。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.chiphell.com/*",
    "https://chiphell.com/*"
  ],
  "action": {
    "default_title": "Chiphell 快速评分",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chiphell.com/*",
        "https://chiphell.com/*"
      ],
      "js": ["forum-response.js", "online-time.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
